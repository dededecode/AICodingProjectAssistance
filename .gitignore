# ================= Python / Django =================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.eggs/

# 运行时数据库 / 向量库 / 上传文件（本地生成，不入库）
backend/db.sqlite3
backend/chroma/
backend/media/
backend/staticfiles/
backend/static/

# ================= 本地配置 / 密钥（严禁提交） =================
# 用 **/ 前缀：该配置可能位于 mcp-client/ 等任意目录，写死 backend/ 会漏掉
**/mcp_server_config.json
# 模板文件需要入库，供使用者复制；因此上面的规则不要扩写成 mcp_server_config*.json
!**/mcp_server_config.example.json
# 登录 RSA 密钥对：后端首启自动生成，无需入库，更不能进镜像
backend/rsa_keys/
.env
.env.*
!.env.example

# ================= 初始数据快照（含数据库与上传文件，严禁提交） =================
# 由 deploy/prepare_data.ps1 本地打包，内含 LLM API Key 与业务数据，仅供部署使用
deploy/data_initial/*
!deploy/data_initial/.gitkeep
# Docker 宿主运行时数据卷
deploy/data/

# ================= 本地缓存 =================
.pip-cache/
.npm-cache/

# ================= 本地调试 / 临时产物 =================
backend/_debug_rich.py
backend/_pixel.png
backend/_sample.docx
backend/_out_img/
backend/_*.png
backend/_*.docx

