# 统一换行符：仓库内一律 LF，避免 Windows 开发在 PR 里产生「整文件都改了」的 diff
* text=auto eol=lf

# 明确按二进制处理，防止 Git 做换行转换或文本 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.svg   binary

*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary

*.sqlite3 binary
*.db      binary
*.pem     binary
*.key     binary

*.docx  binary
*.xlsx  binary
*.pdf   binary

# 语言统计：锁文件不计入仓库语言占比
frontend/package-lock.json linguist-generated=true
